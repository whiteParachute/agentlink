AGENTLINK_HOST=0.0.0.0
AGENTLINK_PORT=8080
AGENTLINK_SERVICE_NAME=agentlink-control-plane
NODE_ENV=development

# Optional: enables live PostgreSQL runtime wiring when set.
AGENTLINK_DATABASE_URL=
AGENTLINK_DATABASE_POOL_MAX=10
AGENTLINK_DATABASE_IDLE_TIMEOUT_MS=30000
AGENTLINK_DATABASE_CONNECTION_TIMEOUT_MS=5000
