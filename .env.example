AGENTLINK_HOST=0.0.0.0
AGENTLINK_PORT=8080
AGENTLINK_SERVICE_NAME=agentlink-control-plane
NODE_ENV=development

# Optional: use PostgreSQL-backed control-plane state.
# Defaults to memory for local protocol smoke tests.
AGENTLINK_STORAGE=memory
AGENTLINK_DATABASE_URL=
AGENTLINK_DATABASE_POOL_MAX=10
AGENTLINK_DATABASE_IDLE_TIMEOUT_MS=30000
AGENTLINK_DATABASE_CONNECTION_TIMEOUT_MS=5000

# Required in production: high-entropy stable secret for AL-M1-006 source_ref HMACs.
# Do not deploy production with the deterministic dev fallback.
AGENTLINK_SOURCE_HASH_SECRET=

# Required in production: bearer token protecting AL-M1-006 ingress/source-event/entry APIs.
# Requests must send: Authorization: Bearer <token>.
AGENTLINK_INGRESS_BEARER_TOKEN=
